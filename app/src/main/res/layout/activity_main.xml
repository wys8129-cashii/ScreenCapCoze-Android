<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">

        <!-- Logo 区域 -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/logo_circle_bg" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Logo" />
        </FrameLayout>

        <!-- App 名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.05" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一键截图 · 智能上传"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp" />

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_status_bg"
            android:padding="18dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前状态"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_ready"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- 使用指南：步骤说明 + 操作按钮合二为一 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@drawable/card_settings_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用指南"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- 步骤 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step1"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_open_settings"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:textColor="@color/brand_purple"
                app:cornerRadius="12dp"
                app:strokeColor="@color/brand_purple"
                app:strokeWidth="1.5dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <!-- 步骤 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step2"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthorize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_authorize"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/brand_primary"
                app:icon="@drawable/ic_screenshot_btn"
                app:iconTint="@color/brand_on_primary"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <!-- 步骤 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step3"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_add_tile"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:textColor="@color/brand_primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1.5dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <!-- 步骤 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step4"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="14dp" />

            <!-- 步骤 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step5"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestCapture"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="测试截图上传"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:textColor="@color/brand_secondary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/brand_secondary"
                app:strokeWidth="1.5dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <!-- 步骤 6：管理后台入口 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_step6"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPortal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_open_portal"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:textColor="@color/brand_purple"
                app:cornerRadius="12dp"
                app:strokeColor="@color/brand_purple"
                app:strokeWidth="1.5dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- 检查更新（版本号动态填充） -->
        <TextView
            android:id="@+id/btnCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查更新"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:padding="10dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
